        3.2,
        1
       ]
      },
      {
       "id": "r-css",
       "label": "écran étroit : l'un sous l'autre"
      }
     ],
     "hud": [
      {
       "label": "largeur",
       "value": "360 px"
      },
      {
       "label": "disposition",
       "value": "une colonne"
      }
     ],
     "say": "Sur un téléphone, c'est **la même page** : les mêmes blocs, rangés les uns sous les autres.",
     "ms": 1100
    },
    {
     "do": "wait",
     "ms": 1600
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "r-css",
       "label": "une règle selon la largeur"
      }
     ],
     "say": "Pas deux sites : une page, et une feuille de style qui choisit selon la largeur. C'est le **responsive design**."
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  },
  {
   "id": "mobile",
   "label": "Mobile",
