     "do": "scene",
     "set": [
      {
       "id": "m-rn",
       "label": "publiée sur les boutiques"
      },
      {
       "id": "m-cap",
       "label": "publiée sur les boutiques"
      }
     ],
     "say": "Les deux se publient sur les boutiques d'applications, et ce que tu sais du web sert dans les deux cas."
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  },
  {
   "id": "electron",
   "label": "Bureau",
   "title": "Chromium pour l'interface, Node.js pour le système",
   "body": [
    "Un logiciel Electron emporte deux programmes : Chromium affiche l'interface, Node.js accède aux fichiers."
   ],
   "hud": [
    {
     "label": "fichier",
     "value": "—"
    }
   ],
   "show": [
    "x-you",
    "x-app",
    "x-chr",
    "x-ui",
    "x-disk"
   ],
   "links": [
    {
     "from": "x-you",
     "to": "x-ui"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 1000
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "x-ui",
       "label": "clic : Ouvrir un fichier"
      }
     ],
     "say": "L'interface est une page web, affichée par **Chromium**. Tu cliques sur « Ouvrir un fichier »."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "scene",
     "link": [
      {
       "from": "x-ui",
       "to": "x-disk",
       "dashed": true,
       "label": "interdit"
      }
     ],
     "hud": [
      {
       "label": "fichier",
       "value": "pas d'accès",
       "tone": "r"
      }
     ],
     "say": "Une page web n'a **pas le droit** de lire ton disque : c'est une protection du navigateur."
    },
    {
     "do": "wait",
     "ms": 1600
    },
    {
     "do": "scene",
     "show": [
      "x-node"
     ],
     "unlink": [
      {
       "from": "x-ui",
       "to": "x-disk"
      }
     ],
     "link": [
      {
       "from": "x-ui",
       "to": "x-node"
      },
      {
       "from": "x-node",
       "to": "x-disk"
      }
     ],
     "say": "Electron ajoute **Node.js**, qui, lui, accède aux fichiers et au système."
    },
    {
     "do": "send",
     "path": [
      "x-ui",
      "x-node",
      "x-disk"
     ],
     "label": "lire rapport.txt",
     "reply": "contenu",
     "kind": "read"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "x-ui",
       "label": "rapport.txt affiché"
      }
     ],
     "hud": [
      {
       "label": "fichier",
       "value": "ouvert",
       "tone": "g"
      }
     ],
     "say": "Node.js lit le fichier et le rend à l'interface, qui l'affiche."
    },
    {
     "do": "wait",
     "ms": 1400
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "x-app",
       "label": "emporte son propre Chromium"
      }
     ],
     "say": "Le prix : chaque logiciel Electron emporte son propre Chromium, et pèse plus lourd qu'un logiciel natif."
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  },
