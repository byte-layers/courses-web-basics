       "tone": "v"
      },
      {
       "id": "r3-0",
       "tone": "v"
      }
     ],
     "say": "Le nom de chaque sortie nomme sa ligne : il devient un th, avec scope=\"row\"."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "pulse",
     "at": "r1-0"
    },
    {
     "do": "pulse",
     "at": "th-2"
    },
    {
     "do": "scene",
     "show": [
      "reader"
     ],
     "link": [
      {
       "from": "r1-2",
       "to": "reader"
      }
     ],
     "say": "Un lecteur d'écran annonce chaque cellule avec ses deux en-têtes : « Pic du Midi, Date : 12 avril »."
    },
    {
     "do": "send",
     "path": [
      "r1-2",
      "reader"
     ],
     "label": "Pic du Midi, Date"
    },
    {
     "do": "wait",
     "ms": 2400
    }
   ]
