  {
   "id": "tableau",
   "label": "Ligne par ligne",
   "title": "Un tableau se construit ligne par ligne",
   "body": [
    "Le programme des sorties d'un club : des données qui ont un sens en lignes et en colonnes."
   ],
   "show": [
    "table"
   ],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "scene",
     "show": [
      "tr-r1",
      "r1-0",
      "r1-1",
      "r1-2"
     ],
     "say": "Un tableau se construit ligne par ligne : une tr, et ses cellules td."
    },
    {
     "do": "wait",
     "ms": 1200
    },
    {
     "do": "scene",
     "show": [
      "tr-r2",
      "r2-0",
      "r2-1",
      "r2-2",
      "tr-r3",
      "r3-0",
      "r3-1",
      "r3-2"
     ],
     "say": "Chaque ligne a trois cellules : les colonnes se forment toutes seules, sans balise pour elles."
    },
    {
     "do": "wait",
     "ms": 1500
    },
    {
     "do": "scene",
     "show": [
      "tr-h",
      "th-0",
      "th-1",
      "th-2"
     ],
     "say": "La ligne d'en-tête nomme les colonnes : des th, avec scope=\"col\"."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "scene",
