 "steps": [
  {
   "id": "utilitaires",
   "label": "Une classe",
   "title": "Une classe, une propriété",
   "body": [
    "Un lien sans style. On lui ajoute des classes utilitaires, une à une."
   ],
   "show": [
    "lien",
    "attr"
   ],
   "hud": [
    {
     "label": "classe",
     "value": "—"
    },
    {
     "label": "CSS écrit",
     "value": "—"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 1000
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "classe",
       "value": "px-4",
       "tone": "g"
      },
      {
       "label": "CSS écrit",
       "value": "padding-inline: 1rem",
       "tone": "g"
      }
     ],
     "set": [
      {
       "id": "lien",
       "size": [
        6.4,
        0.9,
        1
       ]
      },
      {
       "id": "attr",
       "title": "class=\"px-4\""
      }
     ],
     "say": "px-4 écrit une seule propriété : 16 px de padding à gauche et à droite.",
     "ms": 800
    },
    {
     "do": "wait",
     "ms": 1100
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "classe",
       "value": "py-2",
       "tone": "g"
      },
      {
       "label": "CSS écrit",
       "value": "padding-block: 0.5rem",
       "tone": "g"
      }
     ],
     "set": [
      {
       "id": "lien",
       "size": [
        6.4,
        1.6,
        1
       ]
      },
      {
       "id": "attr",
       "title": "class=\"px-4 py-2\""
      }
     ],
     "say": "py-2 : 8 px de padding en haut et en bas.",
     "ms": 800
    },
    {
     "do": "wait",
     "ms": 1100
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "classe",
       "value": "bg-blue-700",
       "tone": "g"
      },
      {
       "label": "CSS écrit",
       "value": "background: bleu 700",
       "tone": "g"
      }
     ],
     "set": [
      {
       "id": "lien",
       "tone": "b"
      },
      {
       "id": "attr",
       "title": "class=\"px-4 py-2 bg-blue-700\""
      }
     ],
     "say": "bg-blue-700 : un fond, la nuance 700 de la palette bleue.",
     "ms": 800
    },
    {
     "do": "wait",
     "ms": 1100
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "classe",
       "value": "text-white",
       "tone": "g"
      },
      {
       "label": "CSS écrit",
       "value": "color: #fff",
       "tone": "g"
      }
     ],
     "set": [
      {
       "id": "lien"
      },
      {
       "id": "attr",
       "title": "class=\"px-4 py-2 bg-blue-700 text-white\""
      }
     ],
     "say": "text-white : le texte en blanc. Le style naît de l'assemblage, écrit dans le HTML.",
     "ms": 800
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  },
  {
   "id": "build",
   "label": "Le traitement",
   "title": "Du HTML et d'une ligne de CSS au fichier que charge la page",
   "body": [
    "Le HTML contient les classes du bouton ; `input.css`, l'import de Tailwind. On lance la commande."
   ],
   "show": [
    "html",
    "input",
    "tw",
    {
     "id": "output",
     "dim": true,
     "note": "pas encore écrit"
    },
    "nav"
   ],
   "links": [
    {
     "from": "html",
     "to": "tw"
    },
    {
     "from": "input",
     "to": "tw"
    },
    {
     "from": "tw",
     "to": "output"
    },
    {
     "from": "output",
     "to": "nav"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "send",
     "path": [
      "input",
      "tw"
     ],
     "label": "@import",
     "kind": "read",
     "explain": [
      "La commande lit `input.css` : une seule ligne, l'import de Tailwind."
     ]
    },
    {
     "do": "send",
     "path": [
      "html",
      "tw"
     ],
     "label": "les classes",
     "kind": "read",
     "explain": [
      "Puis elle parcourt les fichiers du dossier à la recherche de noms de classes."
     ]
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "tw",
       "label": "4 classes trouvées"
      }
     ],
     "say": "Elle trouve quatre classes : px-4, py-2, bg-blue-700, text-white."
    },
    {
     "do": "wait",
     "ms": 800
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "output",
       "dim": false,
       "note": "4 règles"
      }
     ],
     "say": "Elle écrit output.css : les règles de ces quatre classes, et aucune autre."
    },
    {
     "do": "wait",
     "ms": 800
    },
    {
     "do": "send",
     "path": [
      "output",
      "nav"
     ],
     "label": "<link>",
     "explain": [
      "La page charge `output.css` avec son `link` : c'est lui que lit le navigateur, pas `input.css`."
     ]
    },
    {
     "do": "scene",
     "show": [
      "bouton"
     ],
     "say": "Le bouton s'affiche avec son style."
    },
    {
     "do": "wait",
     "ms": 2400
    }
   ]
  },
  {
   "id": "photo",
   "label": "Une photographie",
   "title": "output.css, une photographie du moment du traitement",
   "body": [
    "Le traitement a tourné une fois : `output.css` contient les quatre classes du bouton."
   ],
   "show": [
    "html",
    "input",
    "tw",
    {
     "id": "output",
     "note": "4 règles"
    },
    "nav",
    "bouton"
   ],
   "links": [
    {
     "from": "html",
     "to": "tw"
    },
    {
     "from": "input",
     "to": "tw"
    },
    {
     "from": "tw",
     "to": "output"
    },
    {
     "from": "output",
     "to": "nav"
    }
   ],
   "hud": [
    {
     "label": "output.css",
     "value": "à jour",
     "tone": "g"
    },
    {
     "label": "bouton",
     "value": "fond bleu"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 1000
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "html",
       "note": "+ bg-pink-600 px-6"
      }
     ],
     "hud": [
      {
       "label": "output.css",
       "value": "périmé",
       "tone": "r"
      }
     ],
     "say": "Après le traitement, on change le bouton : bg-pink-600 et px-6 remplacent bg-blue-700 et px-4."
    },
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "send",
     "path": [
      "output",
      "nav"
     ],
     "label": "<link>"
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "bouton",
       "value": "ni fond ni padding",
       "tone": "r"
      }
     ],
     "set": [
      {
       "id": "bouton",
       "tone": "n",
       "size": [
        4.6,
        0.9,
        1
       ]
      }
     ],
     "say": "output.css n'a aucune règle pour ces classes : le bouton perd son fond et son padding, sans message."
    },
    {
     "do": "wait",
     "ms": 1600
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "tw",
       "label": "--watch"
      }
     ],
     "say": "En mode surveillance, avec --watch, Tailwind refait le traitement à chaque enregistrement."
    },
    {
     "do": "send",
     "path": [
      "html",
      "tw"
     ],
     "label": "les classes",
     "kind": "read"
    },
    {
     "do": "send",
     "path": [
      "tw",
      "output"
     ],
     "label": "+ 2 règles"
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "output.css",
       "value": "à jour",
       "tone": "g"
      },
      {
       "label": "bouton",
       "value": "fond rose",
       "tone": "g"
      }
     ],
     "set": [
      {
       "id": "output",
       "note": "règles à jour"
      },
      {
       "id": "bouton",
       "tone": "r",
       "size": [
        6.0,
        1.5,
        1
       ]
      }
     ],
     "say": "output.css contient maintenant les nouvelles classes : le bouton retrouve un fond, rose cette fois."
    },
    {
     "do": "wait",
     "ms": 2400
    }
   ]
  },
  {
   "id": "bundle",
   "label": "Le bundle",
   "title": "Des modules qui s'importent, un bundle pour le navigateur",
   "body": [
    "Un petit projet : `main.js` importe un menu, un appel au serveur et une feuille de style."
   ],
   "show": [
    "m-main"
   ],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "scene",
     "show": [
      "m-menu",
      "m-api",
      "m-css"
     ],
     "link": [
      {
       "from": "m-main",
       "to": "m-menu",
       "label": "import"
      },
      {
       "from": "m-main",
       "to": "m-api",
       "label": "import"
      },
      {
       "from": "m-main",
       "to": "m-css",
       "label": "import"
      }
     ],
     "say": "Vos fichiers s'importent les uns les autres : main.js a besoin de menu.js, d'api.js et de style.css."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "scene",
     "show": [
      "b-tool"
     ],
     "link": [
      {
       "from": "m-menu",
       "to": "b-tool"
      },
      {
       "from": "m-api",
       "to": "b-tool"
      },
      {
       "from": "m-css",
       "to": "b-tool"
      }
     ],
     "say": "L'outil de build part de main.js et suit chaque import."
    },
    {
     "do": "send",
     "path": [
      "m-main",
      "m-api",
      "b-tool"
     ],
     "label": "import",
     "kind": "read"
    },
    {
     "do": "scene",
     "show": [
      "b-js",
      "b-css"
     ],
     "link": [
      {
       "from": "b-tool",
       "to": "b-js"
      },
      {
       "from": "b-tool",
       "to": "b-css"
      }
     ],
     "say": "Il rassemble tout en deux fichiers, compressés : le bundle."
    },
    {
     "do": "wait",
     "ms": 1100
    },
    {
     "do": "scene",
     "show": [
      "b-nav"
     ],
     "link": [
      {
       "from": "b-js",
       "to": "b-nav"
      },
      {
       "from": "b-css",
       "to": "b-nav"
      }
     ],
     "say": "La page charge ces deux fichiers, pas les quatre que vous avez écrits."
    },
    {
     "do": "send",
     "path": [
      "b-js",
      "b-nav"
     ],
     "label": "<script>"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "b-nav",
       "label": "2 fichiers prêts"
      }
     ],
     "say": "Comme avec Tailwind, ce que reçoit le navigateur n'est pas ce que vous avez écrit."
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  }
 ]
