   "title": "un script",
   "sub": "sans navigateur",
   "detail": "Un programme peut envoyer une requête au serveur sans jamais ouvrir la page ni son formulaire."
  }
 ],
 "steps": [
  {
   "id": "formulaire",
   "label": "for, id, name",
   "title": "Un champ relié, et ce qu'il envoie",
   "body": [
    "Un formulaire de contact réduit à un champ : l'e-mail, et son étiquette."
   ],
   "show": [
    "fm-form",
    "fm-label",
    "fm-input",
    "fm-submit",
    "fm-server"
   ],
   "hud": [
    {
     "label": "reçu",
     "value": "rien"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 1000
    },
    {
     "do": "scene",
     "link": [
      {
       "from": "fm-label",
       "to": "fm-input",
       "label": "for = id"
      }
     ],
     "say": "Le for de l'étiquette reprend l'id du champ : l'étiquette est reliée à ce champ."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "pulse",
     "at": "fm-label"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "fm-input",
       "label": "le curseur arrive ici"
      }
     ],
     "say": "Un clic sur l'étiquette met le curseur dans le champ ; un lecteur d'écran l'annonce en y arrivant."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "fm-input",
       "label": "camille@exemple.fr"
      }
     ],
     "say": "Le visiteur tape son adresse."
    },
    {
     "do": "wait",
     "ms": 1000
    },
    {
     "do": "pulse",
     "at": "fm-submit"
    },
    {
     "do": "scene",
     "link": [
      {
       "from": "fm-input",
       "to": "fm-server"
      }
     ],
     "say": "À l'envoi, la valeur part sous le name du champ : email=…, le @ codé en %40."
    },
    {
     "do": "send",
     "path": [
      "fm-input",
      "fm-server"
     ],
     "label": "email=camille%40exemple",
     "tone": "y"
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "reçu",
       "value": "email",
       "tone": "g"
      }
     ]
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  },
  {
   "id": "methode",
   "label": "get ou post",
   "title": "Deux façons d'envoyer les données",
   "body": [
    "Le même formulaire, l'e-mail déjà saisi. Seul change l'attribut method de form."
   ],
   "show": [
    "mt-bar",
    "mt-form",
    "mt-input",
    "mt-submit",
    "mt-server"
   ],
   "hud": [
    {
     "label": "method",
     "value": "—"
    },
    {
     "label": "données",
     "value": "—"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "pulse",
     "at": "mt-submit"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "mt-bar",
       "sub": "exemple.fr/contact?email=camille%40exemple.fr",
       "tone": "y"
      }
     ],
     "link": [
      {
       "from": "mt-bar",
       "to": "mt-server"
      }
     ],
     "hud": [
      {
       "label": "method",
       "value": "get",
       "tone": "y"
      }
     ],
     "say": "Avec method=\"get\", le navigateur ajoute les données à l'adresse, après un ?."
    },
    {
     "do": "send",
     "path": [
      "mt-bar",
      "mt-server"
     ],
     "label": "GET ?email=camille…",
     "tone": "y"
    },
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "données",
       "value": "visibles dans l'adresse",
       "tone": "y"
      }
     ],
     "say": "Cette adresse s'affiche, reste dans l'historique et peut se partager : c'est fait pour une recherche."
    },
    {
     "do": "wait",
     "ms": 1500
    },
    {
     "do": "pulse",
     "at": "mt-submit"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "mt-bar",
       "sub": "exemple.fr/contact",
       "tone": "n"
      }
     ],
     "unlink": [
      {
       "from": "mt-bar",
       "to": "mt-server"
      }
     ],
     "link": [
      {
       "from": "mt-input",
       "to": "mt-server"
      }
     ],
     "hud": [
      {
       "label": "method",
       "value": "post",
       "tone": "v"
      }
     ],
     "say": "Avec method=\"post\", l'adresse reste /contact : les données voyagent dans la requête elle-même."
    },
    {
     "do": "send",
     "path": [
      "mt-input",
      "mt-server"
     ],
     "label": "POST email=camille…",
     "tone": "v"
    },
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "données",
       "value": "dans la requête",
       "tone": "v"
      }
     ],
     "say": "Un message, une inscription : on choisit post, pour que la saisie ne traîne pas dans une adresse."
    },
    {
     "do": "wait",
     "ms": 2400
    }
   ]
  },
  {
   "id": "controle",
   "label": "required, type",
   "title": "Le navigateur contrôle avant d'envoyer",
   "body": [
    "Un formulaire réduit à un champ e-mail, obligatoire."
   ],
   "show": [
    "ct-form",
    "ct-input",
    "ct-submit",
    "ct-server"
   ],
   "hud": [
    {
     "label": "envoi",
     "value": "—"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "pulse",
     "at": "ct-submit"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "ct-input",
       "tone": "r",
       "label": "Veuillez renseigner ce champ."
      }
     ],
     "hud": [
      {
       "label": "envoi",
       "value": "refusé : vide",
       "tone": "r"
      }
     ],
     "say": "Le champ est vide, le visiteur clique sur Envoyer : avec required, le navigateur refuse l'envoi."
    },
    {
     "do": "wait",
     "ms": 1600
    },
    {
     "do": "pulse",
     "at": "ct-submit"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "ct-input",
       "label": "camille : il manque un @"
      }
     ],
     "hud": [
      {
       "label": "envoi",
       "value": "refusé : pas de @",
       "tone": "r"
      }
     ],
     "say": "Il tape « camille » : type=\"email\" fait vérifier la présence d'un @. Refusé encore."
    },
    {
     "do": "wait",
     "ms": 1600
    },
    {
     "do": "pulse",
     "at": "ct-submit"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "ct-input",
       "tone": "y",
       "label": "camille@exemple.fr"
      }
     ],
     "link": [
      {
       "from": "ct-input",
       "to": "ct-server"
      }
     ],
     "hud": [
      {
       "label": "envoi",
       "value": "parti",
       "tone": "g"
      }
     ],
     "say": "Avec une adresse complète, le formulaire part."
    },
    {
     "do": "send",
     "path": [
      "ct-input",
      "ct-server"
     ],
     "label": "email=camille%40…",
     "tone": "y"
    },
    {
     "do": "wait",
     "ms": 1000
    },
    {
     "do": "scene",
     "show": [
      "ct-script"
     ],
     "link": [
      {
       "from": "ct-script",
       "to": "ct-server"
      }
     ],
     "say": "Mais un script peut écrire directement au serveur, sans formulaire : aucun de ces contrôles ne s'applique."
    },
    {
     "do": "send",
     "path": [
      "ct-script",
      "ct-server"
     ],
     "label": "email=n'importe quoi",
     "tone": "r"
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "ct-server",
       "sub": "revérifie tout"
      }
     ],
     "say": "Le serveur doit donc tout revérifier : les contrôles du navigateur rendent service au visiteur."
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  },
  {
   "id": "envoi",
   "label": "Un champ sans name",
   "title": "Ce que le serveur reçoit",
   "body": [
    "Un formulaire de contact à trois champs. À l'écran, rien ne les distingue."
   ],
   "show": [
    "form",
    "f-nom",
    "f-email",
    "f-tel",
    "submit",
    "server"
   ],
   "hud": [
    {
     "label": "reçu",
     "value": "rien"
    }
   ],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "f-nom",
       "label": "Camille"
      },
      {
       "id": "f-email",
       "label": "camille@exemple.fr"
      },
      {
       "id": "f-tel",
       "label": "06 12 34 56 78"
      }
     ],
     "say": "Le visiteur remplit les trois champs : à l'écran, ils se comportent tous pareil."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "pulse",
     "at": "submit"
    },
    {
     "do": "scene",
     "link": [
      {
       "from": "f-nom",
       "to": "server"
      },
      {
       "from": "f-email",
       "to": "server"
      }
     ],
     "say": "Il clique sur Envoyer : le navigateur envoie chaque valeur sous le name de son champ."
    },
    {
     "do": "send",
     "path": [
      "f-nom",
      "server"
     ],
     "label": "nom=Camille",
     "tone": "y"
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "reçu",
       "value": "nom",
       "tone": "g"
      }
     ]
    },
    {
     "do": "send",
     "path": [
      "f-email",
      "server"
     ],
     "label": "email=camille…",
     "tone": "y"
    },
    {
     "do": "scene",
     "hud": [
      {
       "label": "reçu",
       "value": "nom, email",
       "tone": "g"
      }
     ]
    },
    {
     "do": "wait",
     "ms": 600
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "f-tel",
       "tone": "r",
       "sub": "pas de name"
      }
     ],
     "say": "Le téléphone n'a pas d'attribut name : sa valeur ne part pas, et rien ne le signale."
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  }
 ]
}
