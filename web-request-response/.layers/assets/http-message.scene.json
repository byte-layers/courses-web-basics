       "from": "nav",
       "to": "req"
      }
     ],
     "hud": [
      {
       "label": "requête",
       "value": "GET",
       "tone": "b"
      }
     ],
     "say": "Le navigateur écrit sa **requête**, en texte. Première ligne : la méthode `GET`, le chemin, la version de HTTP."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "scene",
     "show": [
      "q2",
      "q3",
      "q4"
     ],
     "say": "Puis des **en-têtes** : le serveur visé, le navigateur qui demande, le format qu'il préfère."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
