     ],
     "link": [
      {
       "from": "h-wifi",
       "to": "h-vu",
       "dashed": true
      }
     ],
     "ms": 200
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "h-vu",
       "title": "x9#fQ2…L7%k",
       "sub": "illisible",
       "tone": "g"
      }
     ],
     "hud": [
      {
       "label": "le trajet lit",
