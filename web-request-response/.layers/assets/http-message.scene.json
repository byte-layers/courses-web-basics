 "steps": [
  {
   "id": "message",
   "label": "Requête, réponse",
   "title": "Une requête, une réponse : du texte",
   "body": [
    "Le navigateur envoie une requête écrite en texte ; le serveur répond en texte, et le corps de la réponse est la page en HTML."
   ],
   "hud": [
    {
     "label": "requête",
     "value": "—"
    },
    {
     "label": "statut",
     "value": "—"
    }
   ],
   "show": [
    "nav",
    "srv"
   ],
   "links": [],
   "script": [
    {
     "do": "wait",
     "ms": 900
    },
    {
