 "steps": [
  {
   "id": "structure",
   "label": "La structure",
   "title": "Une enveloppe, un en-tête, un corps",
   "body": [
    "Une page HTML est un bloc `<html>` qui porte deux parties : l'en-tête `<head>`, pour le navigateur, puis le corps `<body>`, pour ce qui s'affiche."
   ],
   "show": [
    "s-doc"
   ],
   "links": [],
   "widgets": [
    {
     "kind": "editor",
     "title": "index.html",
     "lang": "text",
     "lines": [
      "<!DOCTYPE html>",
      "<html lang=\"fr\">",
      "<head>",
      "  <!-- les infos d'en-tête -->",
      "</head>",
      "<body>",
      "  <!-- le corps : titre, contenu -->",
      "</body>",
      "</html>"
     ]
    }
   ],
   "script": [
    {
     "do": "line",
     "n": 1
    },
    {
     "do": "wait",
     "ms": 1000
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "s-doc",
       "label": "la page est en HTML d'aujourd'hui"
      }
     ],
     "say": "`<!DOCTYPE html>` annonce une page en HTML d'aujourd'hui. C'est une déclaration, pas une balise."
    },
    {
     "do": "wait",
     "ms": 1200
    },
    {
     "do": "line",
     "n": 2
    },
    {
     "do": "scene",
     "show": [
      "s-html"
     ],
     "say": "`<html>` est l'**enveloppe** : tout le reste est dedans, jusqu'à `</html>`."
    },
    {
     "do": "wait",
     "ms": 1200
    },
    {
     "do": "line",
     "n": 3
    },
    {
     "do": "scene",
     "show": [
      "s-head",
      "s-head-i"
     ],
     "say": "`<head>`, l'**en-tête** : des informations pour le navigateur, qui ne s'affichent pas dans la page."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "line",
     "n": 6
    },
    {
     "do": "scene",
     "show": [
      "s-body",
      "s-body-i"
     ],
     "say": "`<body>`, le **corps** : tout ce qui s'affiche, nos titres, nos textes, nos boutons."
    },
    {
     "do": "wait",
     "ms": 1300
    },
    {
     "do": "line",
     "n": 9
    },
    {
     "do": "scene",
     "set": [
      {
       "id": "s-html",
       "label": "fermée"
      }
     ],
     "say": "`</html>` ferme l'enveloppe : une page, c'est toujours un en-tête puis un corps."
    },
    {
     "do": "wait",
     "ms": 2600
    }
   ]
  },
  {
   "id": "base",
   "label": "Ligne par ligne",
   "title": "La structure de base, ligne par ligne",
   "body": [
